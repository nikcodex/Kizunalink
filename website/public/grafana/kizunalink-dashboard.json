{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "description": "", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" }
  ],
  "title": "KizunaLink",
  "uid": "kizunalink-overview",
  "tags": ["kizunalink", "lavalink", "discord"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(kizunalink_uptime_seconds, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Overview", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "panels": [] },
    {
      "id": 1, "type": "stat", "title": "Players",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "expr": "sum(kizunalink_players_total{instance=~\"$instance\"})", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#e11d48" }, "unit": "none" }, "overrides": [] }
    },
    {
      "id": 2, "type": "stat", "title": "Playing",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "expr": "sum(kizunalink_players_playing{instance=~\"$instance\"})", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#f43f5e" }, "unit": "none" }, "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "WebSocket connections",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "expr": "sum(kizunalink_ws_connections{instance=~\"$instance\"})", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "expr": "min(kizunalink_uptime_seconds{instance=~\"$instance\"})", "refId": "A" }],
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "dtdurations" }, "overrides": [] }
    },
    {
      "id": 5, "type": "gauge", "title": "CPU (KizunaLink)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "expr": "max(kizunalink_cpu_usage{instance=~\"$instance\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.6 }, { "color": "red", "value": 0.85 } ] } }, "overrides": [] }
    },
    {
      "id": 6, "type": "stat", "title": "Memory",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "expr": "sum(kizunalink_memory_used_bytes{instance=~\"$instance\"})", "refId": "A" }],
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },

    { "type": "row", "title": "Players & audio", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "id": 101, "panels": [] },
    {
      "id": 7, "type": "timeseries", "title": "Players over time",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum(kizunalink_players_total{instance=~\"$instance\"})", "legendFormat": "total", "refId": "A" },
        { "expr": "sum(kizunalink_players_playing{instance=~\"$instance\"})", "legendFormat": "playing", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15, "lineWidth": 2 }, "unit": "none" }, "overrides": [] }
    },
    {
      "id": 8, "type": "timeseries", "title": "Frame health (last-minute snapshot)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "sum(kizunalink_frames_sent{instance=~\"$instance\"})", "legendFormat": "sent", "refId": "A" },
        { "expr": "sum(kizunalink_frames_nulled{instance=~\"$instance\"})", "legendFormat": "nulled", "refId": "B" },
        { "expr": "sum(kizunalink_frames_deficit{instance=~\"$instance\"})", "legendFormat": "deficit", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10, "lineWidth": 2 }, "unit": "none" }, "overrides": [
        { "matcher": { "id": "byName", "options": "deficit" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
        { "matcher": { "id": "byName", "options": "nulled" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
      ] }
    },

    { "type": "row", "title": "Tracks & sources", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "id": 102, "panels": [] },
    {
      "id": 9, "type": "timeseries", "title": "Tracks loaded / failed per minute",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        { "expr": "sum(rate(kizunalink_tracks_loaded_total{instance=~\"$instance\"}[5m])) * 60", "legendFormat": "loaded", "refId": "A" },
        { "expr": "sum(rate(kizunalink_tracks_failed_total{instance=~\"$instance\"}[5m])) * 60", "legendFormat": "failed", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10, "lineWidth": 2 }, "unit": "none" }, "overrides": [
        { "matcher": { "id": "byName", "options": "failed" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
      ] }
    },
    {
      "id": 10, "type": "piechart", "title": "Source usage (range)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 15 },
      "targets": [
        { "expr": "sum(increase(kizunalink_source_jiosaavn_total{instance=~\"$instance\"}[$__range]))", "legendFormat": "jiosaavn", "refId": "A" },
        { "expr": "sum(increase(kizunalink_source_youtube_total{instance=~\"$instance\"}[$__range]))", "legendFormat": "youtube", "refId": "B" },
        { "expr": "sum(increase(kizunalink_source_spotify_total{instance=~\"$instance\"}[$__range]))", "legendFormat": "spotify", "refId": "C" },
        { "expr": "sum(increase(kizunalink_source_soundcloud_total{instance=~\"$instance\"}[$__range]))", "legendFormat": "soundcloud", "refId": "D" },
        { "expr": "sum(increase(kizunalink_source_deezer_total{instance=~\"$instance\"}[$__range]))", "legendFormat": "deezer", "refId": "E" },
        { "expr": "sum(increase(kizunalink_source_applemusic_total{instance=~\"$instance\"}[$__range]))", "legendFormat": "applemusic", "refId": "F" },
        { "expr": "sum(increase(kizunalink_source_bandcamp_total{instance=~\"$instance\"}[$__range]))", "legendFormat": "bandcamp", "refId": "G" },
        { "expr": "sum(increase(kizunalink_source_twitch_total{instance=~\"$instance\"}[$__range]))", "legendFormat": "twitch", "refId": "H" },
        { "expr": "sum(increase(kizunalink_source_http_total{instance=~\"$instance\"}[$__range]))", "legendFormat": "http", "refId": "I" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "legend": { "displayMode": "list", "placement": "right" }, "pieType": "donut" }
    },
    {
      "id": 11, "type": "timeseries", "title": "Source requests per minute",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 15 },
      "targets": [
        { "expr": "sum(rate(kizunalink_source_jiosaavn_total{instance=~\"$instance\"}[5m])) * 60", "legendFormat": "jiosaavn", "refId": "A" },
        { "expr": "sum(rate(kizunalink_source_youtube_total{instance=~\"$instance\"}[5m])) * 60", "legendFormat": "youtube", "refId": "B" },
        { "expr": "sum(rate(kizunalink_source_spotify_total{instance=~\"$instance\"}[5m])) * 60", "legendFormat": "spotify", "refId": "C" },
        { "expr": "sum(rate(kizunalink_source_soundcloud_total{instance=~\"$instance\"}[5m])) * 60", "legendFormat": "soundcloud", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 0 }, "unit": "none" }, "overrides": [] }
    },

    { "type": "row", "title": "HTTP & errors", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "id": 103, "panels": [] },
    {
      "id": 12, "type": "timeseries", "title": "Requests per second",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [{ "expr": "sum by (instance) (rate(kizunalink_requests_total{instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10, "lineWidth": 2 }, "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 13, "type": "timeseries", "title": "Errors per minute",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "sum(rate(kizunalink_errors_auth_total{instance=~\"$instance\"}[5m])) * 60", "legendFormat": "401 auth", "refId": "A" },
        { "expr": "sum(rate(kizunalink_errors_not_found_total{instance=~\"$instance\"}[5m])) * 60", "legendFormat": "404 not found", "refId": "B" },
        { "expr": "sum(rate(kizunalink_errors_rate_limit_total{instance=~\"$instance\"}[5m])) * 60", "legendFormat": "429 rate limit", "refId": "C" },
        { "expr": "sum(rate(kizunalink_errors_internal_total{instance=~\"$instance\"}[5m])) * 60", "legendFormat": "5xx internal", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10, "lineWidth": 2, "stacking": { "mode": "normal" } }, "unit": "none" }, "overrides": [
        { "matcher": { "id": "byName", "options": "5xx internal" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
      ] }
    },

    { "type": "row", "title": "Process", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "id": 104, "panels": [] },
    {
      "id": 14, "type": "timeseries", "title": "CPU share",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 33 },
      "targets": [{ "expr": "kizunalink_cpu_usage{instance=~\"$instance\"}", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10, "lineWidth": 2 }, "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 15, "type": "timeseries", "title": "Memory (RSS)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 33 },
      "targets": [{ "expr": "kizunalink_memory_used_bytes{instance=~\"$instance\"}", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10, "lineWidth": 2 }, "unit": "bytes" }, "overrides": [] }
    }
  ]
}
