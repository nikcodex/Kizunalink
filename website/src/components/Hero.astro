---
/**
 * Custom landing-page hero for KizunaLink.
 * Replaces Starlight's default Hero via `components.Hero` in astro.config.mjs.
 * Only rendered on pages that set `hero:` in frontmatter (i.e. the home page).
 */
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { tagline } = data.hero || {};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}`;

const version = import.meta.env.KIZUNA_VERSION ?? '4.2.1';
---

<div class="kz-hero not-content">
  <div class="copy">
    <span class="eyebrow"><i class="dot"></i> v{version} · Lavalink v4 compatible</span>
    <h1 id={PAGE_TITLE_ID} data-page-title>
      <span class="grad">KizunaLink</span><span class="kanji">絆</span><br />
      Discord audio, <span class="grad">rewritten in Rust.</span>
    </h1>
    <p class="tagline" set:html={tagline ?? 'A standalone Discord voice &amp; audio streaming engine. Drop-in replacement for Lavalink — no JVM, no GC pauses, ~15 MB of RAM.'} />
    <div class="actions">
      <a class="kz-btn primary" href={href('/getting-started/quick-start/')}>
        Get started
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <a class="kz-btn secondary" href={href('/api/rest/')}>API reference</a>
      <a class="kz-btn secondary" href="https://github.com/nikcodex/Kizunalink" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.35.78 1.05.78 2.12v3.14c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
        GitHub
      </a>
    </div>
    <div class="stats" aria-label="Highlights">
      <div class="stat"><b>~15 MB</b><span>idle memory</span></div>
      <div class="stat"><b>0</b><span>GC pauses</span></div>
      <div class="stat"><b>12</b><span>audio sources</span></div>
      <div class="stat"><b>320 kbps</b><span>native passthrough</span></div>
    </div>
  </div>

  <div class="kz-terminal" aria-label="Example terminal session">
    <div class="bar"><i></i><i></i><i></i><span>kizunalink — bash</span></div>
    <pre><span class="p">$</span> curl -sL https://raw.githubusercontent.com/nikcodex/Kizunalink/main/install.sh | bash
<span class="c">🌸 Installing KizunaLink Audio Core...</span>
<span class="c">✅ KizunaLink installed successfully to ~/kizunalink!</span>

<span class="p">$</span> cd ~/kizunalink && ./kizunalink
<span class="t">2026-09-04T09:12:41Z</span> <span class="i">INFO</span> kizunalink: Loaded config: host=0.0.0.0, port=2333
<span class="t">2026-09-04T09:12:41Z</span> <span class="i">INFO</span> kizunalink: Spotify: Using client_credentials OAuth2 flow
<span class="t">2026-09-04T09:12:41Z</span> <span class="i">INFO</span> kizunalink: ⛩️  KizunaLink v{version} listening on 0.0.0.0:2333

<span class="p">$</span> curl -H <span class="k">"Authorization: youshallnotpass"</span> \
    <span class="k">"http://localhost:2333/v4/loadtracks?identifier=jssearch:Kesariya"</span>
{"{"}<span class="w">"loadType"</span>: <span class="ok">"search"</span>, <span class="w">"data"</span>: [ … 10 tracks … ]{"}"}</pre>
  </div>
</div>
