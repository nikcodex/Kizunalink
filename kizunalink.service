[Unit]
Description=KizunaLink Audio Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=kizuna
Group=kizuna
WorkingDirectory=/opt/kizunalink
ExecStart=/opt/kizunalink/kizunalink
Restart=always
RestartSec=5
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
ReadWritePaths=/opt/kizunalink/plugins

# Environment
Environment=RUST_LOG=info
EnvironmentFile=-/opt/kizunalink/.env

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
